{
  "name": "returno",
  "private": true,
  "version": "0.3.4",
  "description": "Browser-only expected-returns calculator for savings and investments.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node --experimental-strip-types scripts/prerender.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "package:site": "npm run build && python3 scripts/zip-site.py",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
