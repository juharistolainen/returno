{
  "name": "returno",
  "private": true,
  "version": "0.2.0",
  "description": "Browser-only expected-returns calculator for savings and investments.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "package:site": "npm run build && python3 scripts/zip-site.py",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/fraunces": "^5.2.9",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.3.1",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "oxlint": "^1.50.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
